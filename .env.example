# =============================================================================
# OVD // Highway — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Core dependencies (required) -------------------------------------------

# PostgreSQL connection string (pgx). Database and schema are created on boot.
DATABASE_URL=postgres://ovd:ovd@localhost:5432/ovd?sslmode=disable

# Redis connection URL. Used for deduplication (72h TTL) and DLQ dedup keys.
REDIS_URL=redis://localhost:6379/0

# --- LLM qualifier (required) -----------------------------------------------

# API key for the qualifier model. Used with OpenRouter by default, or with
# any OpenAI-compatible endpoint when LLM_BASE_URL is set.
LLM_API_KEY=

# Optional model override (provider-specific, e.g. an OpenRouter model slug).
LLM_MODEL=

# Optional OpenAI-compatible base URL. When empty, OpenRouter is used.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Parallel LLM qualification workers. Default 3, clamped to 1..10.
# LLM_CONCURRENCY=3

# --- Telegram MTProto onramp (required) -------------------------------------

# API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Phone number (international format) used for the MTProto session.
# First run may require an interactive login code — session is persisted
# to session.json next to the binary.
TG_PHONE=

# Comma-separated channel usernames to ingest (leading @ optional).
# Empty = all updates are dropped with a warning.
TG_TARGET_CHANNELS=@channel_one,@channel_two

# --- Telegram control bot (required) ----------------------------------------

# Bot token from @BotFather — receives operator commands.
CONTROL_BOT_TOKEN=

# Numeric Telegram user ID of the admin allowed to control the bot.
ADMIN_TG_ID=

# --- Reddit onramp (optional, OAuth2) ---------------------------------------

# Reddit app credentials. When unset, the reddit connector stays idle.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER=

# --- Engine / HTTP server ----------------------------------------------------

# Address for the HTTP server hosting /ws, /healthz, /readyz, /metrics
# and /api/v1/*. Default: :8080
WS_ADDR=:8080

# Bearer token protecting /api/v1/* and the /ws upgrade (?token=).
# Empty = auth disabled (local dev only — never in production).
ADMIN_API_TOKEN=

# Comma-separated extra WebSocket origins (exact match, scheme+port).
# localhost/127.0.0.1/[::1] origins are always allowed.
# WS_ALLOWED_ORIGINS=https://app.example.com

# Log level: info (default) or debug.
LOG_LEVEL=info

# Set to 1 to enable the mock signal source for local development.
# MOCK_ONRAMP=0

# --- Frontend (ui/, Vite) ----------------------------------------------------

# Base path for Control Plane REST calls. Default: /api/v1 (proxied by Vite).
# VITE_API_BASE=/api/v1

# Explicit WebSocket URL. Default: ws(s)://<page-host>/ws
# VITE_WS_URL=ws://localhost:8080/ws

# --- Legacy / reserved --------------------------------------------------------
# TG_BOT_TOKEN and TG_CHAT_ID are kept for the (currently disabled)
# Telegram lead notifier and are not required at runtime.
# TG_BOT_TOKEN=
# TG_CHAT_ID=
