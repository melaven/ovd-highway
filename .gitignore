# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment and session files
.env
session.json
*.session

# UI build artifacts and dependencies
node_modules/
ui/node_modules/
# Keep the SPA placeholder so `go test -race ./...` compiles in CI before
# `npm run build` has produced real assets.
ui/dist/*
!ui/dist/
!ui/dist/index.html

# Editor/IDE
# .idea/
# .vscode/
.cursorrules
